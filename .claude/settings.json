{
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)"
    ],
    "ask": [
      "Bash(npx *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(HUSKY=0 *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./pnpm-lock.yaml)",
      "Edit(./ios/**)",
      "Edit(./android/**)"
    ]
  }
}
