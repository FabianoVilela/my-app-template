# Optional. Set this when a derived project connects its first API.
# A supplied value must be an HTTP/HTTPS URL (local development hosts allowed).
# The template starts without this value. EXPO_PUBLIC_ values are public.
EXPO_PUBLIC_API_URL=

# Optional default and fallback locale: en or pt-BR. Defaults to en if unset or invalid.
EXPO_PUBLIC_DEFAULT_LOCALE=en

# Local commands default to development. Copy this file to
# .env.development.local, .env.staging.local or .env.production.local.
# APP_VARIANT is selected by the package scripts, not by this file.
# Staging/production commands do not load generic .env or .env.local files.

# Optional public Sentry DSN. Empty disables reporting; debug builds never send.
EXPO_PUBLIC_SENTRY_DSN=
# Build-only source map configuration. Never prefix the auth token with EXPO_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional Firebase services: analytics, crashlytics or both (comma-separated).
# Empty keeps Firebase out of the native build. Crashlytics and Sentry are
# exclusive: leave EXPO_PUBLIC_SENTRY_DSN empty when selecting crashlytics.
FIREBASE_SERVICES=
# Required when FIREBASE_SERVICES is set: this variant's app config files,
# relative to the repository root. Use one Firebase project per variant.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=
