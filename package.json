{
  "name": "my-app-template",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.1 || ^24.3.0 || >=26.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@sentry/react-native": "~8.28.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.7.1",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.8.1",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "expo-mcp": "~0.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "husky",
    "rename-app": "node --experimental-strip-types ./scripts/rename-app.ts",
    "test:rename-app": "node --experimental-strip-types --test ./scripts/rename-app.test.ts",
    "start": "node scripts/expo-variant.mjs development start",
    "android": "node scripts/expo-variant.mjs development run:android",
    "ios": "node scripts/expo-variant.mjs development run:ios",
    "web": "node scripts/expo-variant.mjs development start --web",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:staged": "lint-staged",
    "check:push": "pnpm i18n:check && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm check:push",
    "commitlint:check": "commitlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "i18n:types": "node scripts/i18n-types.mjs",
    "i18n:check": "node scripts/i18n-types.mjs --check",
    "test:variants": "node --experimental-strip-types --test scripts/app-variants.test.mjs",
    "expo:development": "node scripts/expo-variant.mjs development",
    "expo:staging": "node scripts/expo-variant.mjs staging",
    "start:staging": "node scripts/expo-variant.mjs staging start",
    "android:staging": "node scripts/expo-variant.mjs staging run:android --variant release",
    "ios:staging": "node scripts/expo-variant.mjs staging run:ios --configuration Release",
    "expo:production": "node scripts/expo-variant.mjs production",
    "start:production": "node scripts/expo-variant.mjs production start",
    "android:production": "node scripts/expo-variant.mjs production run:android --variant release",
    "ios:production": "node scripts/expo-variant.mjs production run:ios --configuration Release",
    "release:version": "node scripts/release-version.mjs",
    "test:release-version": "node --experimental-strip-types --test scripts/release-version.test.mjs"
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "private": true
}
